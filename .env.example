# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=support-agent
LOG_LEVEL=INFO

# LLM provider: openai | ollama (anthropic: not implemented yet)
# Examples: LLM_PROVIDER=openai + LLM_MODEL=gpt-4.1-mini
#           LLM_PROVIDER=ollama + LLM_MODEL=qwen2.5:3b (local, free)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
OPENAI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
OLLAMA_BASE_URL=http://localhost:11434

# Async driver for the app; Alembic switches to psycopg (sync) for migrations.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
